# ============================================================
# Melao's Studio — Environment Variables
# Managed by FEDGE 2.O | @cryptofedge
# Copy to .env and fill in values
# ============================================================

# Anthropic (Claude) — for prompt enhancement
ANTHROPIC_API_KEY=sk-ant-...

# Memory encryption key — AES-256 (must be exactly 32 characters)
MEMORY_ENCRYPTION_KEY=your-32-character-secret-key-here

# Agent identity
AGENT_ID=melaos-studio
AGENT_VERSION=1.0.0

# WhatsApp session path (default: sessions/whatsapp)
WA_SESSION_PATH=sessions/whatsapp

# Suno session path (default: sessions/suno)
SUNO_SESSION_PATH=sessions/suno

# Playwright browser settings
PLAYWRIGHT_HEADLESS=true

# FEDGE 2.O Agent Bus (optional — for IPC with parent process)
FEDGE_BUS_ENABLED=true
FEDGE_BUS_POLL_INTERVAL_MS=5000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/melaos-studio.log

# Song generation timeout (ms)
SUNO_GENERATION_TIMEOUT_MS=120000

# Node environment
NODE_ENV=production
